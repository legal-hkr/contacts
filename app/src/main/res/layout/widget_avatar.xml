<?xml version="1.0" encoding="utf-8"?>
<!-- The one-contact widget's round photo (SPEC §14.2), as large as its container: the photo cut to a circle, or the letters on a tinted circle. The surface circle under it casts the shadow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription"
    android:id="@+id/avatar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_circle"
    android:backgroundTint="@color/widget_surface"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/avatar_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_circle" />

    <TextView
        android:id="@+id/avatar_letters"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text=""
        android:textSize="40dp" />

    <ImageView
        android:id="@+id/avatar_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
