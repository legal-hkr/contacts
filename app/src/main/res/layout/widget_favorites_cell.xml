<?xml version="1.0" encoding="utf-8"?>
<!-- One favorite: the 48 dp avatar – the photo cut to a circle, or the letters on a tinted circle – and the short name under it (label-medium, one line, ellipsis). An empty cell at the end of the last row is the same cell made invisible, so the columns stay in place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription"
    android:id="@+id/cell"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/avatar_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_circle" />

        <TextView
            android:id="@+id/avatar_letters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textSize="20dp" />

        <ImageView
            android:id="@+id/avatar_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text=""
        android:textColor="@color/widget_on_surface"
        android:textSize="12dp" />
</LinearLayout>
