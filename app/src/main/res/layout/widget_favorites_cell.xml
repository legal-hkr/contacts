<?xml version="1.0" encoding="utf-8"?>
<!-- One favorite (the owner, 18 Nov 2026): the 48 dp avatar – the photo cut to a circle, or the letters on a tinted circle – and under it, over its lower edge by 8 dp, the short name in a pill on the surface (20 dp, label-medium, one line, ellipsis). The circle under the avatar is the surface: it casts the avatar's shadow. The pill comes after the avatar, so it is drawn over it. An empty cell at the end of the last row is the same cell made invisible, so the columns stay in place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription"
    android:id="@+id/cell"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:clipChildren="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_circle"
        android:backgroundTint="@color/widget_surface"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/avatar_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_circle" />

        <TextView
            android:id="@+id/avatar_letters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textSize="20dp" />

        <ImageView
            android:id="@+id/avatar_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="-8dp"
        android:background="@drawable/widget_name_pill"
        android:elevation="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text=""
        android:textColor="@color/widget_on_surface"
        android:textSize="12dp" />
</LinearLayout>
