<?xml version="1.0" encoding="utf-8"?>
<!-- The one-contact widget at 2 × 1 (SPEC §14.2): the round photo at the start and Call over Message (40 dp, smaller in a low widget) over its end edge by half; no name – the photo is the name at this size. Sizes and the overlap are set in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ContentDescription,UseAppTint"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipChildren="false"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="2dp">

        <FrameLayout
            android:id="@+id/disc"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:clipChildren="false">

            <include layout="@layout/widget_avatar" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-20dp"
            android:clipChildren="false"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/call"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_button_call"
                android:elevation="2dp"
                android:padding="10dp"
                android:src="@drawable/ic_call"
                android:tint="@color/widget_on_primary_container" />

            <ImageView
                android:id="@+id/message"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_button_message"
                android:elevation="2dp"
                android:padding="10dp"
                android:src="@drawable/ic_chat"
                android:tint="@color/widget_on_secondary_container" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
