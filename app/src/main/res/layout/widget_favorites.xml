<?xml version="1.0" encoding="utf-8"?>
<!-- The Favorites widget (SPEC §14.1, as Calendar's Agenda since the owner's word of 18 Nov 2026): no background of its own; the header pill "Favorites" on its own at the top, wherever a row fits under it, then the rows of favorites, which the code adds (FavoritesGrid says how many). Every piece casts its own shadow, so nothing on the way clips: clipChildren off on every container, clipToPadding off where there is padding; 2 dp all round leave room for the shadows. Sizes are in dp, text too: the launcher's font scale would push the names out of their pills. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipChildren="false"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="2dp">

        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:clipChildren="false">

            <include layout="@layout/widget_badge" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
