<?xml version="1.0" encoding="utf-8"?>
<!-- The Favorites widget without favorites or without access (SPEC §14.3), without a background of its own as the favorites: one piece on the surface (radius 18, its own shadow) with an icon, one sentence and, without access, "Open Contacts". In one column the icon alone, one row high the sentence alone; the whole piece opens the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipChildren="false"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/state_piece"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="2dp"
        android:background="@drawable/widget_piece"
        android:elevation="2dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/state_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/widget_on_surface_variant"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/state_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text=""
            android:textColor="@color/widget_primary"
            android:textSize="14dp" />
    </LinearLayout>
</FrameLayout>
